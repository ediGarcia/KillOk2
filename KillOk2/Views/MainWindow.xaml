<ui:FluentWindow x:Class="KillOk2.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewModels="clr-namespace:KillOk2.ViewModels"
                 xmlns:models="clr-namespace:KillOk2.Models"
                 mc:Ignorable="d"
                 Title="Kill OK 2" Height="450" Width="800"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
                 x:Name="Root"
                 Loaded="MainWindow_OnLoaded"
                 Closing="MainWindow_OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True"
            Title="{Binding Title, ElementName=Root}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid
            Grid.Row="1"
            Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="300" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Filter panel -->
            <Grid
                Grid.Column="0"
                Margin="0, 0, 16, 0">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- Text box -->
                <Grid
                    Grid.Row="0"
                    Margin="0, 0, 0, 16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox
                        Grid.Column="0"
                        PlaceholderText="Enter the process name"
                        Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding
                                Command="{Binding AddNewProcessCommand}"
                                Key="Enter" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button
                        Grid.Column="1"
                        Command="{Binding AddNewProcessCommand}"
                        Content="{ui:SymbolIcon Add16}"
                        Margin="5, 0, 0, 0"
                        ToolTip="Add filter" />
                </Grid>

                <!-- Filters list -->
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    ScrollChanged="ScrollViewer_OnScrollChanged">
                    <ItemsControl
                        ItemsSource="{Binding ProcessesFilters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate
                                DataType="{x:Type viewModels:ProcessFilterViewModel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition
                                            Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ui:TextBlock
                                        Grid.Row="0"
                                        FontTypography="BodyStrong"
                                        Margin="0, 0, 0, 10"
                                        Text="{Binding Name}"
                                        TextWrapping="Wrap" />

                                    <ui:Button
                                        Grid.Row="1"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.RemoveProcessCommand, ElementName=Root}"
                                        CommandParameter="{Binding }"
                                        Content="{ui:SymbolIcon Delete16}"
                                        HorizontalAlignment="Right"
                                        ToolTip="Remove filter">
                                    </ui:Button>

                                    <StackPanel
                                        Grid.Row="1"
                                        Orientation="Horizontal">
                                        <ToggleButton
                                            Content="{ui:SymbolIcon {StaticResource InfoSymbol}}"
                                            IsChecked="{Binding AcceptInfo, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Information Dialogs" />
                                        <ToggleButton
                                            Content="{ui:SymbolIcon {StaticResource QuestionSymbol}}"
                                            IsChecked="{Binding AcceptQuestion, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="2, 0"
                                            ToolTip="Question Dialogs (not recommended)" />
                                        <ToggleButton
                                            Content="{ui:SymbolIcon {StaticResource WarningSymbol}}"
                                            IsChecked="{Binding AcceptWarning, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Warning Dialogs" />
                                        <ToggleButton
                                            Content="{ui:SymbolIcon {StaticResource ErrorSymbol}}"
                                            IsChecked="{Binding AcceptError, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="2, 0"
                                            ToolTip="Error Dialogs" />
                                        <ToggleButton
                                            Content="{ui:SymbolIcon {StaticResource OtherSymbol}}"
                                            IsChecked="{Binding AcceptOther, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Other Dialogs (not recommended)" />
                                    </StackPanel>

                                    <Separator
                                        Grid.Row="2"
                                        HorizontalAlignment="Stretch"
                                        Margin="0, 8"
                                        Background="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Dialogs list -->
            <Grid
                Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <ui:Button
                    Grid.Row="0"
                    Appearance="Primary"
                    Command="{Binding ToggleClosingDialogsCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="0, 0, 0, 16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="51" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Right">
                            <ui:TextBlock.Style>
                                <Style
                                    TargetType="ui:TextBlock">
                                    <Setter
                                        Property="Text"
                                        Value="Idle" />

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsRunning}"
                                            Value="True">
                                            <Setter
                                                Property="Text"
                                                Value="Running" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:TextBlock.Style>
                        </ui:TextBlock>

                        <Border
                            x:Name="BrdRunning"
                            Grid.Column="1"
                            CornerRadius="5"
                            Height="10"
                            Margin="10, 3, 0, 0"
                            RenderTransformOrigin=".5, .5"
                            Width="10">
                            <Border.RenderTransform>
                                <ScaleTransform
                                    ScaleX="1"
                                    ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style
                                    TargetType="Border">
                                    <Setter
                                        Property="Background"
                                        Value="Gray" />

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsRunning}"
                                            Value="True">
                                            <Setter
                                                Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush
                                                        Color="{DynamicResource PaletteGreenColor}" />
                                                </Setter.Value>
                                            </Setter>

                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard
                                                    Name="RunningStoryboard">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            AutoReverse="True"
                                                            Duration="00:00:00.375"
                                                            RepeatBehavior="Forever"
                                                            To="1.5"
                                                            Storyboard.TargetProperty="RenderTransform.ScaleX" />
                                                        <DoubleAnimation
                                                            AutoReverse="True"
                                                            Duration="00:00:00.375"
                                                            RepeatBehavior="Forever"
                                                            To="1.5"
                                                            Storyboard.TargetProperty="RenderTransform.ScaleY" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard
                                                    BeginStoryboardName="RunningStoryboard" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </ui:Button>

                <Border
                    Grid.Row="1"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        ScrollChanged="ScrollViewer_OnScrollChanged">
                        <ItemsControl
                            ItemsSource="{Binding ClosedDialogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate
                                    DataType="{x:Type models:DialogInfo}">
                                    <Grid
                                        Background="Transparent"
                                        Tag="{Binding DataContext, ElementName=Root}">
                                        <Grid.ContextMenu>
                                            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                            <ContextMenu>
                                                <MenuItem
                                                    Header="Copy"
                                                    Icon="{ui:SymbolIcon Copy16}">
                                                    <MenuItem
                                                        Command="{Binding PlacementTarget.Tag.CopyDialogMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                        CommandParameter="{Binding }"
                                                        Header="Message" />
                                                    <MenuItem
                                                        Command="{Binding PlacementTarget.Tag.CopyDialogTitleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                        CommandParameter="{Binding }"
                                                        Header="Title" />
                                                    <MenuItem
                                                        Command="{Binding PlacementTarget.Tag.CopyDialogProcessNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                        CommandParameter="{Binding }"
                                                        Header="Process Name" />
                                                    <MenuItem
                                                        Command="{Binding PlacementTarget.Tag.CopyDialogProcessIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                        CommandParameter="{Binding }"
                                                        Header="Process ID" />
                                                </MenuItem>
                                                <MenuItem
                                                    Command="{Binding PlacementTarget.Tag.RemoveDialogInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding }"
                                                    Header="Remove from list"
                                                    Icon="{ui:SymbolIcon ChannelDismiss16}" />
                                                <Separator />
                                                <MenuItem
                                                    Command="{Binding PlacementTarget.Tag.ClearClosedDialogsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Clear list"
                                                    Icon="{ui:SymbolIcon Delete16}" />
                                            </ContextMenu>
                                            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                        </Grid.ContextMenu>
                                        <Grid.RowDefinitions>
                                            <RowDefinition
                                                Height="Auto" />
                                            <RowDefinition
                                                Height="Auto" />
                                            <RowDefinition />
                                            <RowDefinition
                                                Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel
                                            Grid.Row="0"
                                            Orientation="Horizontal">
                                            <ui:TextBlock
                                                FontTypography="Subtitle"
                                                Text="{Binding ProcessName}" />
                                            <ui:TextBlock
                                                FontTypography="BodyStrong"
                                                Margin="5, 0, 10, 0"
                                                Text="{Binding ProcessId, StringFormat='{}[{0}]'}"
                                                VerticalAlignment="Bottom" />
                                            <ui:TextBlock
                                                FontTypography="Caption"
                                                Text="{Binding ClosedTime, StringFormat='{}(HH:mm:ss)'}"
                                                VerticalAlignment="Bottom" />
                                        </StackPanel>

                                        <ui:TextBlock
                                            Grid.Row="1"
                                            FontTypography="BodyStrong"
                                            Margin="0, 10"
                                            Text="{Binding Title}" />

                                        <Grid
                                            Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition
                                                    Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>


                                            <ui:SymbolIcon
                                                Grid.Column="0"
                                                FontSize="40"
                                                Margin="0, 0, 16, 0">
                                                <ui:SymbolIcon.Style>
                                                    <Style
                                                        BasedOn="{StaticResource {x:Type ui:SymbolIcon}}"
                                                        TargetType="ui:SymbolIcon">
                                                        <Setter
                                                            Property="Symbol"
                                                            Value="{StaticResource OtherSymbol}" />
                                                        <Setter
                                                            Property="ToolTip"
                                                            Value="Other" />

                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding Type}"
                                                                Value="Error">
                                                                <Setter
                                                                    Property="Symbol"
                                                                    Value="{StaticResource ErrorSymbol}" />
                                                                <Setter
                                                                    Property="ToolTip"
                                                                    Value="Error" />
                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Type}"
                                                                Value="Information">
                                                                <Setter
                                                                    Property="Symbol"
                                                                    Value="{StaticResource InfoSymbol}" />
                                                                <Setter
                                                                    Property="ToolTip"
                                                                    Value="Information" />
                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Type}"
                                                                Value="Question">
                                                                <Setter
                                                                    Property="Symbol"
                                                                    Value="{StaticResource QuestionSymbol}" />
                                                                <Setter
                                                                    Property="ToolTip"
                                                                    Value="Question" />
                                                            </DataTrigger>

                                                            <DataTrigger
                                                                Binding="{Binding Type}"
                                                                Value="Warning">
                                                                <Setter
                                                                    Property="Symbol"
                                                                    Value="{StaticResource WarningSymbol}" />
                                                                <Setter
                                                                    Property="ToolTip"
                                                                    Value="Warning" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>

                                            <ui:TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Message}"
                                                TextWrapping="Wrap"
                                                VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator
                                            Grid.Row="3"
                                            HorizontalAlignment="Stretch"
                                            Margin="0, 8"
                                            Background="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>