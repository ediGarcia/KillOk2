<Application x:Class="KillOk2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <ui:SymbolRegular x:Key="ErrorSymbol">
                DismissCircle16
            </ui:SymbolRegular>

            <ui:SymbolRegular x:Key="InfoSymbol">
                Info16
            </ui:SymbolRegular>

            <ui:SymbolRegular x:Key="OtherSymbol">
                CalendarEmpty16
            </ui:SymbolRegular>

            <ui:SymbolRegular x:Key="QuestionSymbol">
                QuestionCircle16
            </ui:SymbolRegular>

            <ui:SymbolRegular x:Key="WarningSymbol">
                Warning16
            </ui:SymbolRegular>

            <Style TargetType="ui:SymbolIcon">
                <Setter
                    Property="FontSize"
                    Value="20" />
            </Style>

            <Style TargetType="ui:TextBlock">
                <Setter
                    Property="VerticalAlignment"
                    Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
